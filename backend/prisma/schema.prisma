generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String?
  password    String?  // Optional 
  name        String
  phone       String   @unique // Primary identifier for login
  location    String?  // User's current location (e.g. "Chennai")
  latitude    Float?   // Latitude coordinate for radius-based notifications
  longitude   Float?   // Longitude coordinate for radius-based notifications
  pushToken   String?  // Expo push notification token
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items           Item[]
  complaints      Complaint[]
  notifications   Notification[]
  
  // Organization & Community relations
  ownedOrgs       Organization[] @relation("OrgCreator")
  orgAdmins       OrganizationAdmin[]
  ownedCommunities Community[] @relation("CommunityCreator")
  memberships     CommunityMember[]

  // Chat & Call relations
  sentConversations     Conversation[] @relation("ConversationInitiator")
  receivedConversations Conversation[] @relation("ConversationRecipient")
  sentMessages          Message[]
  initiatedCalls        CallRequest[]  @relation("CallInitiator")
  receivedCalls         CallRequest[]  @relation("CallRecipient")
}

model Item {
  id          String     @id @default(uuid())
  name        String
  category    String
  location    String
  date        String
  description String
  contactInfo String?    // Made optional – phone no longer required
  imageUris   String[]
  questions   Question[]
  status          String     @default("OPEN") // Added status
  claimedByUserId String?
  recoveredAt     DateTime?
  feedbackRating  Int?
  feedbackComment String?
  reopenReason    String?
  linkedComplaintId String?
  createdAt   DateTime   @default(now())
  
  // Target filters for notification/search
  latitude          Float?
  longitude         Float?
  notifyRadius      Int?       @default(1) // in km
  targetCommunityId String?
  targetOrganizationId String?
  
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
}

model Question {
  id       String @id @default(uuid())
  question String
  answer   String
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
}

model Complaint {
  id          String   @id @default(uuid())
  name        String
  category    String
  location    String
  date        String
  description String
  contactInfo String?  // Made optional – phone no longer required
  imageUris   String
  status      String   @default("OPEN")
  closureReason String? // Added
  reopenReason  String? // Added
  resolvedAt    DateTime? // Added
  feedbackRating  Int?
  feedbackComment String?
  createdAt   DateTime @default(now())
  
  // Cash Prize
  cashPrize       String?  // Can be "1000 INR" or "Reward"
  
  // Target filters for notification/search
  latitude          Float?
  longitude         Float?
  notifyRadius      Int?       @default(1) // in km
  targetCommunityId String?
  targetOrganizationId String?
  
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  conversations Conversation[]
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String?  // e.g., "CLAIM_REQUEST", "SYSTEM"
  payload   String?  // JSON string for additional data (e.g., founderPhone, items)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

// ===== In-App Private Communication =====

model Conversation {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  initiatorId String
  initiator   User   @relation("ConversationInitiator", fields: [initiatorId], references: [id])
  recipientId String
  recipient   User   @relation("ConversationRecipient", fields: [recipientId], references: [id])

  complaintId   String?
  complaint     Complaint? @relation(fields: [complaintId], references: [id])

  messages    Message[]
  callRequests CallRequest[]
}

model Message {
  id             String       @id @default(uuid())
  content        String
  createdAt      DateTime     @default(now())
  read           Boolean      @default(false)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
}

model CallRequest {
  id             String       @id @default(uuid())
  status         String       @default("PENDING") // PENDING, ACCEPTED, REJECTED, ENDED
  createdAt      DateTime     @default(now())
  endedAt        DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  initiatorId    String
  initiator      User         @relation("CallInitiator", fields: [initiatorId], references: [id])
  recipientId    String
  recipient      User         @relation("CallRecipient", fields: [recipientId], references: [id])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  
  creatorId   String
  creator     User     @relation("OrgCreator", fields: [creatorId], references: [id])
  
  admins      OrganizationAdmin[]
  communities Community[]
}

model OrganizationAdmin {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
}

model Community {
  id             String        @id @default(uuid())
  name           String
  description    String?
  scope          String        @default("PUBLIC") // PUBLIC = searchable by all, PRIVATE = invite-only
  createdAt      DateTime      @default(now())
  
  creatorId      String
  creator        User          @relation("CommunityCreator", fields: [creatorId], references: [id])
  
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  members        CommunityMember[]
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        String    @default("MEMBER") // ADMIN, MEMBER
  createdAt   DateTime  @default(now())
}
